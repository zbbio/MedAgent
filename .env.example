# LLM configuration. Every deployment must use its own API credentials.
# Providers: openai_compatible | anthropic
LLM_PROVIDER=openai_compatible
LLM_API_KEY=replace_with_your_own_api_key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=replace_with_your_model_name
LLM_REQUIRE_API_KEY=true
LLM_TOKEN_PARAMETER=max_tokens
MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# Native Anthropic example:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=replace_with_your_anthropic_key
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=replace_with_your_claude_model

# Local OpenAI-compatible server example (Ollama/vLLM):
# LLM_PROVIDER=openai_compatible
# LLM_REQUIRE_API_KEY=false
# LLM_API_KEY=
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=replace_with_your_local_model

# Access control (both values are required; never commit real values)
MEDAGENT_ACCESS_PASSWORD=replace_with_a_strong_password
MEDAGENT_SESSION_SECRET=replace_with_at_least_32_random_bytes
SESSION_TTL_SECONDS=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Request and generation limits
MAX_QUESTION_CHARS=2000
MAX_HISTORY_ITEMS=10
MAX_HISTORY_CHARS=20000
MAX_CONCURRENT_GENERATIONS=3
MAX_PENDING_GENERATIONS=6
QUEUE_WAIT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=120

# PubMed
PUBMED_API_KEY=
PUBMED_MAX_RESULTS=5
PUBMED_TIMEOUT_SECONDS=15

# Pinned MedRAG Textbooks corpus (18 sources / 125,847 chunks).
# Review docs/corpus-licensing.md before accepting the upstream data terms.
TEXTBOOKS_ENABLED=true
TEXTBOOKS_AUTO_DOWNLOAD=true
MEDRAG_TEXTBOOKS_ACCEPT_TERMS=false
# Optional override for advanced deployments:
# TEXTBOOKS_CORPUS_DIR=/app/data/index/medrag/textbooks

# Optional reranker
COHERE_API_KEY=

# HTTP server
API_HOST=0.0.0.0
API_PORT=8000
